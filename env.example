# session-bridge environment template — copy to ~/.config/devin-bridge/env
# and fill in real values. Keep the file mode 600. Never commit real tokens.

# Slack app credentials (from your Slack app settings)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-socket-token

# Channel the bridge watches. Private channels work: invite the app and
# use the manifest in manifest.private-channel.draft.json.
SLACK_CHANNEL_ID=C00000000

# --- agent process ------------------------------------------------------
# Command used to spawn the agent. Default: "devin acp".
#DEVIN_ACP=devin acp
# Explicit API key for the ACP authenticate call. If unset the bridge tries,
# in order: the Devin Desktop active-account key (state.vscdb) then
# ~/.local/share/devin/credentials.toml.
#DEVIN_ACP_API_KEY=
# Session permission mode, sent via session/set_mode. Default: bypass.
DEVIN_SESSION_MODE=bypass
# "0" to require interactive approval cards for permission requests
# (default "1" auto-approves locally).
#BRIDGE_AUTO_APPROVE=1

# --- sessions / turns ---------------------------------------------------
# Root directory for per-thread workdirs. Default: ~/devin-tasks
#DEVIN_TASKS_DIR=~/devin-tasks
# Prompt silence timeout in seconds, or "inf" (default 1800). A turn with
# no activity this long is declared stuck; pending approvals are exempt.
PROMPT_TIMEOUT=inf
# Idle session retention in seconds, or "inf" (default 3600).
SESSION_IDLE_SEC=inf
# Approval wait in seconds, or "inf" = never auto-deny.
PERMISSION_TIMEOUT_SEC=inf
# Grace period after session/cancel before the process group is killed.
#CANCEL_GRACE_SEC=10
# Max auto-dispatched (bot-posted) sessions at once; humans always start.
BRIDGE_MAX_AUTO_SESSIONS=1
# "0" disables live draft streaming if the typing indicator feels jumpy.
BRIDGE_DRAFT=0
# Comma-separated Slack sender ids the bridge must ignore entirely.
#BRIDGE_BLOCK_SENDERS=
# Shared memory file each thread's AGENTS.md points at.
#BRIDGE_MEMORY_FILE=~/.config/devin-bridge/memory.md
# Pinned dashboard refresh throttle (seconds) and the global devin
# session store used by !sessions/!adopt.
#BRIDGE_BOARD_GAP=30
#BRIDGE_DEVIN_DB=~/.local/share/devin/cli/sessions.db

# --- limit governor -----------------------------------------------------
# Turns killed by a server-side limit ("Reached … rate limit" or a
# retryable refusal) park into <tasks_dir>/.bridge_limits.json and
# auto-resume: at the server-quoted reset time when given, else
# exponential backoff BRIDGE_LIMIT_BACKOFF→CAP (30s→300s), at most one
# resume per RESUME_GAP so a batch doesn't re-trip in lockstep, up to
# RESUME_MAX attempts per turn. Events land in .bridge_limits.log;
# `!limits` shows the queue in Slack.
#BRIDGE_LIMIT_RESUME_MAX=8
#BRIDGE_LIMIT_BACKOFF=30
#BRIDGE_LIMIT_BACKOFF_CAP=300
#BRIDGE_LIMIT_RESUME_GAP=15
#BRIDGE_LIMIT_SWEEP_SEC=15
# At startup, workdirs left failed/interrupted on a limit signature
# newer than this (seconds) are parked for auto-resume.
#BRIDGE_LIMIT_ADOPT_AGE=21600
# Desktop/CLI sessions share the same account limit — when their
# transcript tail shows they stalled on it (or ended mid-turn inside a
# limit window), a one-shot acp session/load resumes them. EXTERNAL=0
# disables. Sessions still locked by a live frontend are only tracked
# as 'suspects' in !limits; EXT_STEAL=1 lets the bridge unlink those
# locks and take the session over — intrusive, off by default.
# EXT_WINDOW bounds how recent the stall must be; EXT_MAX caps
# victims parked per scan; EXT_POST posts a channel line per resume.
#BRIDGE_LIMIT_EXTERNAL=1
#BRIDGE_LIMIT_EXT_STEAL=0
#BRIDGE_LIMIT_EXT_WINDOW=3600
#BRIDGE_LIMIT_EXT_SCAN_SEC=90
#BRIDGE_LIMIT_EXT_MAX=6
#BRIDGE_LIMIT_EXT_POST=1
# EXT_FRESH: a mid-turn tail only counts as dead once its newest node
# is this stale (live turns keep writing; long tool calls can go quiet
# for minutes). Lower = faster rescue, higher = safer vs live turns.
#BRIDGE_LIMIT_EXT_FRESH=600

# --- host ---------------------------------------------------------------
PATH=/usr/local/bin:/usr/bin:/bin
PYTHONUNBUFFERED=1
# Proxy if your network needs one for Slack wss/https.
#HTTP_PROXY=http://127.0.0.1:7897
#HTTPS_PROXY=http://127.0.0.1:7897
